%% erllama umbrella: apps/erllama (the library, published to Hex) and
%% apps/erllama_server (the release). Shared tooling lives here; the NIF
%% build hooks live in apps/erllama/rebar.config.

{minimum_otp_vsn, "28"}.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, []}.

{project_plugins, [
    {rebar3_proper, "~> 0.12.1"},
    {rebar3_hex, "~> 7.1.0"},
    {rebar3_ex_doc, "~> 0.3.0"},
    {rebar3_lint, "~> 5.0.4"},
    {erlfmt, "~> 1.8.0"}
]}.

{shell, [
    {config, "apps/erllama/config/sys.config"},
    {apps, [erllama]}
]}.

%% The `erllama` CLI: an escript holding only erllama_server's modules
%% (not the erllama app or its NIF), built before every release and
%% shipped beside it as bin/erllama_cli with the bin/erllama launcher.
{escript_main_app, erllama_server}.
{escript_name, erllama}.
{escript_incl_apps, [erllama_server]}.
{escript_emu_args, "%%! -escript main erllama_server_cli\n"}.

{provider_hooks, [{pre, [{release, escriptize}]}]}.

{relx, [
    {release, {erllama_server, "0.1.0"}, [sasl, {ssl, load}, erllama_server]},
    {sys_config, "config/sys.config"},
    {vm_args_src, "config/vm.args.src"},
    {extended_start_script, true},
    {dev_mode, true},
    {include_erts, false},
    {overlay, [
        {copy, "{{base_dir}}/bin/erllama", "bin/erllama_cli"},
        {copy, "rel/erllama", "bin/erllama"}
    ]}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        {deps, [{proper, "~> 1.4.0"}]}
    ]},
    {prod, [
        {relx, [{dev_mode, false}, {include_erts, true}]}
    ]}
]}.

{dialyzer, [
    {warnings, [error_handling, no_return, unmatched_returns, unknown]},
    {plt_apps, top_level_deps},
    {plt_extra_apps, [os_mon]}
]}.

{xref_checks, [
    undefined_function_calls,
    locals_not_used,
    deprecated_function_calls
]}.

{erlfmt, [
    write,
    {files, [
        "apps/*/{src,test,include}/**/*.{hrl,erl,app.src,escript}",
        "apps/*/rebar.config",
        "rebar.config"
    ]}
]}.
