%% erllama umbrella: apps/erllama (the library, published to Hex) and
%% apps/erllama_server (the release). Shared tooling lives here; the NIF
%% build hooks live in apps/erllama/rebar.config.

{minimum_otp_vsn, "28"}.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, []}.

{project_plugins, [
    {rebar3_proper, "~> 0.12.1"},
    {rebar3_hex, "~> 7.1.0"},
    {rebar3_ex_doc, "~> 0.3.0"},
    {rebar3_lint, "~> 5.0.4"},
    {erlfmt, "~> 1.8.0"}
]}.

{shell, [
    {config, "apps/erllama/config/sys.config"},
    {apps, [erllama]}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        {deps, [{proper, "~> 1.4.0"}]}
    ]}
]}.

{dialyzer, [
    {warnings, [error_handling, no_return, unmatched_returns, unknown]},
    {plt_apps, top_level_deps},
    {plt_extra_apps, [os_mon]}
]}.

{xref_checks, [
    undefined_function_calls,
    locals_not_used,
    deprecated_function_calls
]}.

{erlfmt, [
    write,
    {files, [
        "apps/*/{src,test,include}/**/*.{hrl,erl,app.src,escript}",
        "apps/*/rebar.config",
        "rebar.config"
    ]}
]}.
