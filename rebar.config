%% erllama: native Erlang/OTP runtime for llama.cpp (library, no release).

{minimum_otp_vsn, "28"}.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, []}.

{pre_hooks, [
    {clean, "rm -f priv/*.so"},
    {clean, "rm -rf _build/cmake"},
    {"(linux|darwin|solaris)", compile, "./do_cmake.sh $ERLLAMA_OPTS"},
    {"(freebsd|netbsd|openbsd)", compile, "./do_cmake.sh $ERLLAMA_OPTS"}
]}.

{post_hooks, [
    {"(linux|darwin|solaris)", compile, "./do_llama.sh $ERLLAMA_BUILDOPTS"},
    {"(freebsd|netbsd|openbsd)", compile, "./do_llama.sh $ERLLAMA_BUILDOPTS"}
]}.

{project_plugins, [
    {rebar3_proper, "~> 0.12.1"},
    {rebar3_hex, "~> 7.1.0"},
    {rebar3_ex_doc, "~> 0.3.0"},
    {rebar3_lint, "~> 5.0.4"},
    {erlfmt, "~> 1.8.0"}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [erllama]}
]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        {deps, [{proper, "~> 1.4.0"}]}
    ]}
]}.

{dialyzer, [
    {warnings, [error_handling, no_return, unmatched_returns, unknown]},
    {plt_apps, top_level_deps},
    {plt_extra_apps, [os_mon]}
]}.

{xref_checks, [
    undefined_function_calls,
    locals_not_used,
    deprecated_function_calls
]}.

{erlfmt, [
    write,
    {files, [
        "{src,test,include}/**/*.{hrl,erl,app.src,escript}",
        "rebar.config"
    ]}
]}.

{hex, [
    {doc, ex_doc}
]}.

{ex_doc, [
    {source_url, <<"https://github.com/benoitc/erllama">>},
    {extras, [
        {<<"README.md">>, #{title => <<"Overview">>}},
        {<<"CHANGELOG.md">>, #{title => <<"Changelog">>}},
        {<<"guides/loading.md">>, #{title => <<"Loading a model">>}},
        {<<"guides/generation.md">>, #{title => <<"Generating text">>}},
        {<<"guides/sessions.md">>, #{title => <<"Sessions">>}},
        {<<"guides/tool-calls.md">>, #{title => <<"Tool calls">>}},
        {<<"guides/multimodal.md">>, #{title => <<"Vision and audio input">>}},
        {<<"guides/tokens.md">>, #{title => <<"Tokens and vocabulary">>}},
        {<<"guides/embeddings.md">>, #{title => <<"Embeddings">>}},
        {<<"guides/adapters.md">>, #{title => <<"LoRA adapters">>}},
        {<<"guides/caching.md">>, #{title => <<"Caching">>}},
        {<<"guides/observability.md">>, #{title => <<"Observability">>}},
        {<<"guides/testing.md">>, #{title => <<"Testing your code">>}},
        {<<"guides/configuration.md">>, #{title => <<"Configuration">>}},
        {<<"guides/building.md">>, #{title => <<"Building">>}},
        {<<"guides/examples.md">>, #{title => <<"Examples">>}},
        {<<"guides/middleware.md">>, #{title => <<"Middleware">>}},
        {<<"internals/cache-design.md">>, #{title => <<"Cache design">>}},
        {<<"internals/publish-protocol.md">>, #{title => <<"Publish protocol">>}},
        {<<"internals/request-lifecycle.md">>, #{title => <<"Request lifecycle">>}},
        {<<"internals/nif-safety.md">>, #{title => <<"NIF safety">>}},
        {<<"internals/c-safety-audit.md">>, #{title => <<"C safety audit">>}},
        {<<"AGENTS.md">>, #{title => <<"Contributor guide">>}},
        {<<"UPDATE_LLAMA.md">>, #{title => <<"Updating llama.cpp">>}},
        {<<"LICENSE">>, #{title => <<"License">>}}
    ]},
    {groups_for_extras, [
        {<<"Guides">>, [
            <<"guides/loading.md">>,
            <<"guides/generation.md">>,
            <<"guides/sessions.md">>,
            <<"guides/tool-calls.md">>,
            <<"guides/tokens.md">>,
            <<"guides/embeddings.md">>,
            <<"guides/adapters.md">>,
            <<"guides/caching.md">>,
            <<"guides/observability.md">>,
            <<"guides/testing.md">>,
            <<"guides/configuration.md">>,
            <<"guides/building.md">>,
            <<"guides/examples.md">>,
            <<"guides/middleware.md">>
        ]},
        {<<"Internals">>, [
            <<"internals/cache-design.md">>,
            <<"internals/publish-protocol.md">>,
            <<"internals/request-lifecycle.md">>,
            <<"internals/nif-safety.md">>,
            <<"internals/c-safety-audit.md">>
        ]},
        {<<"Contributing">>, [
            <<"AGENTS.md">>,
            <<"UPDATE_LLAMA.md">>
        ]}
    ]},
    {groups_for_modules, [
        {<<"API">>, [erllama, erllama_cache, erllama_middleware, erllama_scheduler]},
        {<<"Extending">>, [
            erllama_model_backend, erllama_model_evictor, erllama_model_stub, erllama_pressure
        ]}
    ]},
    {main, <<"readme">>}
]}.
