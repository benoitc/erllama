+    def prefill_rows(self, requests):
+        fresh = [(slot, ids) for slot, ids in requests if not self.slot(slot).tokens and len(ids) > 2]
+        grouped = set()
+        fresh.sort(key=lambda row: len(row[1]))
+        for start in range(0, len(fresh) - 1, 2):
+            pair = fresh[start:start + 2]
+            lengths = [len(ids) - 1 for _, ids in pair]
+            if lengths[1] <= 2 * lengths[0]:
+                self.prefill_fresh(pair, lengths, lengths[1])
+                grouped.update(slot for slot, _ in pair)
+        for slot, ids in requests:
+            if slot not in grouped:
+                self.prefill(self.slot(slot), ids)
+
+    def prefill_fresh(self, rows, lengths, width):
+        layers = self.make_cache(self.model)
+        ids = self.mx.array([tokens[:-1] + [0] * (width - n) for (_, tokens), n in zip(rows, lengths)])
+        # Causal attention cannot see right padding from a valid position.
+        # Recurrent layers must stop updating each row at its last real token.
+        if min(lengths) < width:
+            for layer, weights in zip(layers, self.model.layers):
+                if weights.is_linear:
+                    layer.prepare(lengths=lengths)
+        chunk = max(1, 512 // len(rows))
+        for start in range(0, width, chunk):
+            self.model(ids[:, start:start + chunk], cache=layers)
+            self.mx.eval([layer.state for layer in layers])
+        for i, ((slot, tokens), length) in enumerate(zip(rows, lengths)):
+            seq = self.slot(slot)
+            for j, (layer, weights) in enumerate(zip(layers, self.model.layers)):
+                if weights.is_linear:
+                    seq.layers[j] = layer.extract(i)
+                else:
+                    # Keep the allocated page so the first suffix can append in place.
+                    seq.layers[j].state = layer.keys[i:i + 1], layer.values[i:i + 1], length
+            seq.tokens.extend(tokens)
+            seq.pending = True
+
