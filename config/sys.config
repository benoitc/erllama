%% erllama_server release configuration.
[
    {kernel, [{logger_level, info}]},
    {erllama, [
        %% Memory pressure: erllama's scheduler evicts KV cache rows first,
        %% then asks erllama_server_models to unload the least recently
        %% used model that no request holds.
        {scheduler, #{
            enabled => true,
            pressure_source => system,
            unload_models_under_pressure => true,
            model_evictor => erllama_server_models
        }}
    ]},
    {erllama_server, [
        %% Where the model registry and downloads live. Default: the
        %% platform user data directory (~/.local/share/erllama).
        %% {data_dir, "/var/lib/erllama"},
        %% How long an idle model stays loaded (ms or infinity).
        {keep_alive_ms, 300000}
    ]}
].
