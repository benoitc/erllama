[
    {erllama, [
        %% See src/erllama.app.src for every key and its default, and
        %% guides/configuration.md for what each one does.
        {tiers, []},
        {min_tokens, 512},
        {cold_min_tokens, 512},
        {cold_max_tokens, 30000},
        {continued_interval, 2048},
        {boundary_trim_tokens, 32},
        {boundary_align_tokens, 2048},
        {session_resume_wait_ms, 500},
        {evict_save_timeout_ms, 30000},
        {fingerprint_mode, safe},
        {chat_cache_size, 64},
        {middleware, []},
        {scheduler, #{
            enabled => false,
            pressure_source => noop,
            interval_ms => 5000,
            high_watermark => 0.85,
            low_watermark => 0.75,
            min_evict_bytes => 1048576,
            evict_tiers => [ram, ram_file]
        }}
    ]}
].
