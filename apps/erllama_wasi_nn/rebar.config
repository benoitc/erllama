%% erllama_wasi_nn: serves wasi:nn guests of erlang_wasm from models
%% loaded in erllama. Built from the repository root.
%%
%% `wasi_nn` is in no Hex release of erlang_wasm yet, so the dependency
%% is pinned by git and this app cannot be published to Hex until it is.
%% The OTP application is `wasm`.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {wasm,
        {git, "https://github.com/benoitc/erlang_wasm.git",
            {ref, "cc56b56676537577806395bfd4969fdb0884a807"}}}
]}.
