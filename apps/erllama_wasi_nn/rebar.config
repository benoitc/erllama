%% erllama_wasi_nn: serves wasi:nn guests of erlang_wasm from models
%% loaded in erllama. Built from the repository root.
%%
%% erlang_wasm is published on Hex as `erlang_wasm`; its OTP application
%% is `wasm` (the Hex package named `wasm` is an unrelated project).

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {wasm, "~> 0.11.0", {pkg, erlang_wasm}}
]}.
