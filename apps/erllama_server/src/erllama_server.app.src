{application, erllama_server, [
    {description, "erllama server release: models, conversations, agent runs and APIs"},
    {vsn, "0.2.0"},
    {registered, [
        erllama_server_sup,
        erllama_server_failures,
        erllama_server_registry,
        erllama_server_models,
        erllama_server_runs,
        erllama_server_convs,
        erllama_server_responses,
        erllama_server_run_sup,
        erllama_server_pull_sup,
        erllama_server_agent_sup,
        erllama_server_mcp,
        erllama_server_http
    ]},
    {mod, {erllama_server_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        erllama,
        livery,
        instrument,
        barrel_mcp
    ]},
    {env, []},
    {modules, []},
    {licenses, ["MIT"]},
    {links, [{"GitHub", "https://github.com/benoitc/erllama"}]}
]}.
