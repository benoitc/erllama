%% erllama_server: the release that owns models, conversations and agent
%% runs. Built from the repository root; the release itself is declared
%% in the root rebar.config.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {livery, "0.15.1"},
    %% Livery records HTTP metrics with it; /metrics renders its registry.
    {instrument, "2.0.0"},
    %% MCP: clients of configured servers, and the opt-in /mcp endpoint.
    {barrel_mcp, "4.8.1"}
]}.

{hex, [
    {doc, ex_doc}
]}.

%% rebar3 ex_doc --app erllama_server runs from the repository root, so
%% the extras below are paths from there, as in the library's config.
{ex_doc, [
    {source_url, <<"https://github.com/benoitc/erllama">>},
    {extras, [
        {<<"apps/erllama_server/README.md">>, #{title => <<"Overview">>}},
        {<<"apps/erllama_server/CHANGELOG.md">>, #{title => <<"Changelog">>}},
        {<<"guides/server/demo.md">>, #{title => <<"A walkthrough">>}},
        {<<"guides/server/rpc.md">>, #{title => <<"Driving the release from the CLI">>}},
        {<<"guides/server/models.md">>, #{title => <<"Managing models">>}},
        {<<"guides/server/http.md">>, #{title => <<"The HTTP APIs">>}},
        {<<"guides/server/conversations.md">>, #{title => <<"Conversations">>}},
        {<<"guides/server/agent.md">>, #{title => <<"Agent sessions">>}},
        {<<"guides/server/mcp.md">>, #{title => <<"MCP servers">>}},
        {<<"guides/server/operations.md">>, #{title => <<"Operating the release">>}},
        {<<"internals/server-design.md">>, #{title => <<"Server design">>}},
        {<<"LICENSE">>, #{title => <<"License">>}}
    ]},
    {groups_for_extras, [
        {<<"Guides">>, [
            <<"guides/server/demo.md">>,
            <<"guides/server/rpc.md">>,
            <<"guides/server/models.md">>,
            <<"guides/server/http.md">>,
            <<"guides/server/conversations.md">>,
            <<"guides/server/agent.md">>,
            <<"guides/server/mcp.md">>,
            <<"guides/server/operations.md">>
        ]},
        {<<"Internals">>, [
            <<"internals/server-design.md">>
        ]}
    ]},
    {groups_for_modules, [
        {<<"API">>, [erllama_server_api]}
    ]},
    {main, <<"readme">>}
]}.
